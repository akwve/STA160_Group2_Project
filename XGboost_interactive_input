        "import gradio as gr\n",
        "import joblib\n",
        "\n",
        "# Load the saved model and vectorizer\n",
        "model = joblib.load(\"xgboost_fake_news_model.pkl\")\n",
        "vectorizer = joblib.load(\"tfidf_vectorizer.pkl\")\n",
        "\n",
        "def predict_news(text):\n",
        "    \"\"\"Return model prediction for user input text.\"\"\"\n",
        "    if not text.strip():\n",
        "        return \"⚠️ Please enter some text.\"\n",
        "\n",
        "    # Convert text to TF-IDF vector\n",
        "    X_input = vectorizer.transform([text])\n",
        "\n",
        "    # Predict\n",
        "    pred = model.predict(X_input)[0]\n",
        "\n",
        "    # XGBoost outputs 0/1, so map to labels\n",
        "    return \"🟢 Real News\" if pred == 1 else \"🔴 Fake News\"\n",
        "\n",
        "# Create Gradio interface\n",
        "demo = gr.Interface(\n",
        "    fn=predict_news,\n",
        "    inputs=gr.Textbox(\n",
        "        label=\"Enter a news headline or paragraph\",\n",
        "        placeholder=\"Paste a news article or claim here...\",\n",
        "        lines=6,\n",
        "    ),\n",
        "    outputs=gr.Textbox(label=\"Prediction\"),\n",
        "    title=\"📰 Fake News Detector (XGBoost)\",\n",
        "    description=\"This model uses TF-IDF features and XGBoost to classify news text as Real or Fake.\",\n",
        ")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    demo.launch()"
